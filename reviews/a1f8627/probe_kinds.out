"a := b, c := d"       -> (:(:=), :a, (:(:=), (:tuple, :b, :c), :d))   kinds=["Identifier", "Whitespace", ":=", "Whitespace", "Identifier", ",", "Whitespace", "Identifier", "Whitespace", ":=", "Whitespace", "Identifier", "EndMarker"]
