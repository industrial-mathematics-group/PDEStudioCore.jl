"a => b, c => d"       -> (:tuple, (:call, :(=>), :a, :b), (:call, :(=>), :c, :d))   kinds=["Identifier", "Whitespace", "=>", "Whitespace", "Identifier", ",", "Whitespace", "Identifier", "Whitespace", "=>", "Whitespace", "Identifier", "EndMarker"]
