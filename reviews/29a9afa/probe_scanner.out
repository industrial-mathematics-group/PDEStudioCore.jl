--- Char literal end vs Julia tokenizer
"'\\''"                    scanner end=3          lastindex=4  Meta.parse: Char '\''
"'\\\\'"                   scanner end=4          lastindex=4  Meta.parse: Char '\\'
"'é'"                      scanner end=4          lastindex=4  Meta.parse: Char 'é'
"'\\U0010ffff'"            scanner end=12         lastindex=12  Meta.parse: Char '\U10ffff'
"'\\xf4\\x90\\x80\\x80'"   scanner end=nothing    lastindex=18  Meta.parse: Char '\U110000'
"'\\xc3\\xa9'"             scanner end=10         lastindex=10  Meta.parse: Char 'é'
"'ab'"                     scanner end=nothing    lastindex=4  Meta.parse: error
"''"                       scanner end=nothing    lastindex=2  Meta.parse: error
"'''"                      scanner end=nothing    lastindex=3  Meta.parse: Char '\''
"'\"'"                     scanner end=3          lastindex=3  Meta.parse: Char '"'
"'\\\"'"                   scanner end=4          lastindex=4  Meta.parse: Char '"'
"'\\101'"                  scanner end=6          lastindex=6  Meta.parse: Char 'A'
"'a"                       scanner end=nothing    lastindex=2  Meta.parse: Expr :($(Expr(:incomplete, Base.Meta.ParseError("P
"'"                        scanner end=nothing    lastindex=1  Meta.parse: Expr :($(Expr(:incomplete, Base.Meta.ParseError("P
--- bypasses (Julia parses deep nesting the scanner does not see)
('\'','"', deep)                                   too_nested=false  (4013 chars)
('\'','"',deep) val2str-like spacing               too_nested=true  (4014 chars)
""" " """, deep  (triple-quoted, odd quote)        too_nested=false  (4014 chars)
"$(deep)"  (interpolation)                         too_nested=false  (4006 chars)
"$("$(…)")" nested interpolation x2000             too_nested=true  (10001 chars)
(1)^ x2000                                         too_nested=false  (8001 chars)
(1)^ x20000                                        too_nested=false  (80001 chars)
(a)-> x20000                                       too_nested=false  (100001 chars)
(1)=> x20000                                       too_nested=false  (100001 chars)
(1)- x100000                                       too_nested=false  (400001 chars)
begin; x20000                                      too_nested=false  (240001 chars)
let; x20000                                        too_nested=false  (200001 chars)
if true; x20000                                    too_nested=false  (280001 chars)
(x)' x20000                                        too_nested=false  (80000 chars)
[1]' alternating                                   too_nested=false  (80000 chars)
-(1) chain: -(-(…)) brackets                       too_nested=true  (6001 chars)
1-\n x2000 (tested)                                too_nested=true  (6001 chars)
x₁ subscripts 2000 (one identifier)                too_nested=true  (2001 chars)
--- false rejections of val2str output
Any['\'', '"', "a'b"]                              too_nested=false
('\'', "x")                                        too_nested=false
Dict('\'' => '"')                                  too_nested=false
[:x₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁₁   too_nested=true
:α′α′α′α′α′α′α′α′α′α′α′α′α′α′α′α′α′α′α′α′α′α′α′α   too_nested=true
"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa   too_nested=false
Any[:a => 1]                                       too_nested=false
(:k1, :k2, :k3, :k4, :k5, :k6, :k7, :k8, :k9, :k   too_nested=false
Any["\$([[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[   too_nested=false
BigFloat[1.2338405969061734792274390994867800574   too_nested=false
1//3 + 2//1*im                                     too_nested=false
1//3 + 2//5*im                                     too_nested=false
[1.0 3.0 5.0; 2.0 4.0 6.0]                         too_nested=false
:x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x̂x                          too_nested=true
